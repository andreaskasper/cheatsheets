#!/bin/bash
#
# Prueft Dateien gegen die von md5er erzeugten .md5-Dateien.
#
# Ein Skript fuer Manuel vom Haus des Dokumentarfilms
# Autor: Andreas Kasper <andreas.kasper@goo1.de>
# Seit 2023-10-03

set -u

VERSION="v1.1.260827"

UPDATER_NAME="update-andiscripts.sh"

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

show_help() {
  cat <<'EOF'
Verwendung: md5check [ORDNER]

Prueft alle Dateien im angegebenen Ordner rekursiv gegen ihre .md5-Dateien.
Meldet eine Warnung, wenn die Pruefsumme fehlt, und einen Fehler, wenn sie nicht
uebereinstimmt. Am Ende steht eine Bilanz.

Versteckte Dateien und Ordner werden ausgelassen, genau wie bei md5er.

Optionen:
  --help      Diese Hilfe
  --version   Versionsinformationen
  update      Alle Skripte aktualisieren

Rueckgabewert:
  0  alle geprueften Dateien stimmen und keine Pruefsumme fehlt
  1  mindestens eine Pruefsumme fehlt oder weicht ab

Der Rueckgabewert ist wichtig, wenn md5check in einem groesseren Ablauf laeuft:
nur so laesst sich eine Kopie automatisch als sauber oder fehlerhaft bewerten.
EOF
}

show_version() {
  echo "md5check $VERSION"
}

run_update() {
  local candidate
  for candidate in \
    "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$UPDATER_NAME" \
    "/usr/local/bin/$UPDATER_NAME" \
    "/opt/homebrew/bin/$UPDATER_NAME" \
    "$(command -v "$UPDATER_NAME" 2>/dev/null)"
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      exec "$candidate"
    fi
  done

  echo "$UPDATER_NAME nicht gefunden." >&2
  echo "Bitte einmalig manuell installieren, siehe README.md im Repository." >&2
  exit 1
}

if command -v md5 >/dev/null 2>&1; then
  hash_file() { md5 -q "$1"; }
elif command -v md5sum >/dev/null 2>&1; then
  hash_file() { md5sum "$1" | awk '{print $1}'; }
else
  echo "Weder md5 noch md5sum gefunden." >&2
  exit 1
fi

case "${1:-}" in
  --help|-h|help|\?)
    show_help
    exit 0
    ;;
  --version|-v|version)
    show_version
    exit 0
    ;;
  update|upgrade)
    run_update
    ;;
esac

if [ -z "${1:-}" ]; then
  echo "Kein Ordner angegeben."
  read -r -p "Aktuellen Ordner verwenden: $(pwd)? (j/N) " choice
  case "$choice" in
    j|J|ja|Ja|y|Y|yes) ;;
    *) echo "Abgebrochen."; exit 1 ;;
  esac
  TARGET_DIR="$(pwd)"
else
  TARGET_DIR="$1"
fi

if [ ! -d "$TARGET_DIR" ]; then
  echo "Fehler: '$TARGET_DIR' ist kein gueltiger Ordner." >&2
  exit 1
fi

TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

echo "🕰️ Start: $(date '+%Y-%m-%d %H:%M:%S')"
echo "Ordner: $TARGET_DIR"

ok=0
missing=0
mismatch=0

while IFS= read -r -d '' FILE; do
  HASH_FILE="${FILE}.md5"

  if [ ! -f "$HASH_FILE" ]; then
    printf "${YELLOW}[WARN]${NC} %s - md5 fehlt\n" "$(basename "$FILE")"
    missing=$((missing + 1))
    continue
  fi

  # awk nimmt das erste Feld. Damit passen sowohl das nackte Format von
  # 'md5 -q' als auch 'hash  dateiname' von md5sum.
  EXPECTED_HASH="$(awk 'NR==1{print $1}' "$HASH_FILE")"
  CURRENT_HASH="$(hash_file "$FILE")"

  if [ -z "$EXPECTED_HASH" ]; then
    printf "${YELLOW}[WARN]${NC} %s - .md5-Datei ist leer\n" "$(basename "$FILE")"
    missing=$((missing + 1))
  elif [ "$EXPECTED_HASH" = "$CURRENT_HASH" ]; then
    printf "${GREEN}✓${NC} %s\n" "$(basename "$FILE")"
    ok=$((ok + 1))
  else
    printf "${RED}[FEHLER] %s - md5 weicht ab${NC}\n" "$(basename "$FILE")"
    printf "         erwartet %s, gelesen %s\n" "$EXPECTED_HASH" "$CURRENT_HASH"
    mismatch=$((mismatch + 1))
  fi
done < <(find "$TARGET_DIR" -mindepth 1 \( -name '.*' -prune \) -o \
  -type f ! -name '*.md5' ! -name '*.md5.tmp' -print0)

echo
echo "Geprueft und in Ordnung: $ok"
echo "Ohne Pruefsumme: $missing"
echo "Abweichend: $mismatch"
echo "Fertig: $(date '+%Y-%m-%d %H:%M:%S')"

if [ "$mismatch" -gt 0 ]; then
  printf "${RED}Ergebnis: nicht in Ordnung${NC}\n"
  exit 1
fi

if [ "$missing" -gt 0 ]; then
  printf "${YELLOW}Ergebnis: unvollstaendig, es fehlen Pruefsummen${NC}\n"
  exit 1
fi

printf "${GREEN}Ergebnis: alles in Ordnung${NC}\n"
exit 0
