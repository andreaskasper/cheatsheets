function findFFmpegTools() {
    global $config;
    
    // Find ffprobe
    foreach (FFPROBE_PATHS as $path) {
        if (isExecutableAvailable($path)) {
            $config['ffprobe_path'] = $path;
            break;
        }
    }
    
    // Find ffmpeg
    foreach (FFMPEG_PATHS as $path) {
        if (isExecutableAvailable($path)) {
            $config['ffmpeg_path'] = $path;
            break;
        }
    }
    
    return !empty($config['ffprobe_path']) && !empty($config['ffmpeg_path']);
}

function isExecutableAvailable($path) {
    exec("which $path 2>/dev/null", $output, $return_code);
    if ($return_code === 0) return true;
    
    exec("$path -version 2>/dev/null", $output, $return_code);
    return $return_code === 0;
}

function setupFiles() {
    global $config, $output_file, $progress_file;
    
    $timestamp = date("Ymd") . "T" . date("His");
    $extension = $config['output_format'];
    
    $output_file = dirname($config['directory']) . "/archiv_" . $timestamp . "." . $extension;
    $progress_file = dirname($config['directory']) . "/archiv_" . $timestamp . PROGRESS_FILE_SUFFIX;
    
    // Check if output file exists
    if (file_exists($output_file)) {
        if (!$config['dry_run']) {
            $response = readline("Output file already exists. Overwrite? (y/N): ");
            if (strtolower($response) !== 'y') {
                output("Aborted.", 1);
                exit(0);
            }
        }
    }
}

function loadProgress() {
    global $processed_files, $progress_file;
    
    if (file_exists($progress_file)) {
        $data = file_get_contents($progress_file);
        $processed_files = json_decode($data, true) ?: [];
        output("Resuming: " . count($processed_files) . " files already processed", 1);
    }
}

function saveProgress($file_path) {
    global $processed_files, $progress_file, $config;
    
    if ($config['dry_run']) return;
    
    $processed_files[] = $file_path;
    file_put_contents($progress_file, json_encode($processed_files));
}

function scanDirectoryRecursive($dir) {
    global $config, $stats;
    
    $files = [];
    $dirs_to_scan = [$dir];
    
    while (!empty($dirs_to_scan)) {
        $current_dir = array_shift($dirs_to_scan);
        
        // Check exclude patterns
        $excluded = false;
        foreach ($config['exclude_patterns'] as $pattern) {
            if (strpos($current_dir, $pattern) !== false) {
                $excluded = true;
                output("Excluding directory: $current_dir (matches '$pattern')", 2);
                break;
            }
        }
        
        if ($excluded) continue;
        
        $items = @scandir($current_dir);
        if ($items === false) {
            error("Cannot read directory: $current_dir", false);
            $stats['errors']++;
            continue;
        }
        
        foreach ($items as $item) {
            if ($item === '.' || $item === '..') continue;
            
            $full_path = $current_dir . '/' . $item;
            
            if (is_dir($full_path)) {
                $dirs_to_scan[] = $full_path;
            } else {
                $files[] = $full_path;
            }
        }
    }
    
    return $files;
}

function filterVideoFiles($files) {
    $video_files = [];
    
    foreach ($files as $file) {
        $extension = strtolower(substr($file, strrpos($file, '.')));
        
        if (in_array($extension, SUPPORTED_EXTENSIONS)) {
            $video_files[] = $file;
        }
    }
    
    return $video_files;
}

function initializeOutputFile() {
    global $config, $output_file;
    
    switch ($config['output_format']) {
        case 'csv':
            $header = getCSVHeader($config['info_level']);
            file_put_contents($output_file, $header);
            break;
        case 'json':
            file_put_contents($output_file, "[\n");
            break;
        case 'xml':
            $xml_header = '<?xml version="1.0" encoding="UTF-8"?>' . "\n<video_files>\n";
            file_put_contents($output_file, $xml_header);
            break;
    }
}

function getCSVHeader($info_level) {
    // Standard columns (always included)
    $columns = [
        'Pfad', 'Datei', 'Dateigroesse', 'Dateigroesse_human', 
        'Duration', 'Duration_sec', 'Video_Bitrate', 
        'Video_Codec_lang', 'Video_Codec', 'Breite', 'Höhe', 
        'Seitenverhältnis', 'Pixelverhältnis', 'Farbraum', 
        'Pixelformat', 'Framerate', 'Scantype', 'Frames', 
        'Timecode', 'Erstelldatum'
    ];
    
    // More level: Add audio and extended video properties
    if (in_array($info_level, ['more', 'max', 'full'])) {
        $columns = array_merge($columns, [
            'Audio_Codec', 'Audio_Bitrate', 'Audio_Channels', 
            'Audio_Samplerate', 'Audio_Language', 'Audio_Streams_Count',
            'Video_Profile', 'Video_Level', 'Bit_Depth', 
            'Chroma_Subsampling', 'Encoding_Tool', 'Container_Format'
        ]);
    }
    
    // Max level: Add quality analysis and technical details  
    if (in_array($info_level, ['max', 'full'])) {
        $columns = array_merge($columns, [
            'GOP_Size', 'B_Frames', 'Total_Bitrate', 'Compression_Ratio',
            'Quality_Score', 'Subtitle_Tracks', 'Chapter_Count',
            'File_Permissions', 'Last_Modified', 'Interlace_Detection',
            'Motion_Level'
        ]);
    }
    
    // Full level: Add diagnostics and all stream details
    if ($info_level === 'full') {
        $columns = array_merge($columns, [
            'All_Streams_Count', 'Video_Streams_Count', 'Compliance_Status',
            'Encoding_Complexity', 'Black_Frames_Start', 'Black_Frames_End',
            'Scene_Changes', 'Duplicate_Frames', 'Format_Tags',
            'Muxing_Tool', 'Raw_Analysis_Time'
        ]);
    }
    
    // Always add checksum and data columns at the end
    $columns = array_merge($columns, ['md5', 'SHA', 'data']);
    
    return implode(';', $columns) . "\n";
}

function processVideoFiles($video_files) {
    global $stats, $processed_files, $config;
    
    $total = count($video_files);
    $current = 0;
    
    foreach ($video_files as $file_path) {
        $current++;
        
        // Skip if already processed (resume functionality)
        if (in_array($file_path, $processed_files)) {
            $stats['files_skipped']++;
            updateProgress($current, $total, basename($file_path) . " (skipped)");
            continue;
        }
        
        updateProgress($current, $total, basename($file_path));
        
        if ($config['dry_run']) {
            output("Would process: $file_path", 2);
            $stats['files_processed']++;
        } else {
            $success = processVideoFile($file_path);
            if ($success) {
                $stats['files_processed']++;
                saveProgress($file_path);
            } else {
                $stats['errors']++;
            }
        }
        
        $stats['total_size'] += filesize($file_path);
    }
    
    // Clear progress line
    if ($config['verbose_level'] > 0) {
        echo "\n";
    }
}

