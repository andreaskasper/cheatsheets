function getVideoMetadata($file_path) {
    global $config;
    
    $start_time = microtime(true);
    
    // Base FFprobe command - always needed
    $cmd = escapeshellcmd($config['ffprobe_path']) . ' -v quiet -print_format json -show_format -show_streams ' . escapeshellarg($file_path) . ' 2>&1';
    
    exec($cmd, $output, $return_code);
    
    if ($return_code !== 0) {
        output("FFprobe failed for: $file_path", 2);
        return false;
    }
    
    $json_string = implode('', $output);
    $json = json_decode($json_string, true);
    
    if ($json === null) {
        output("Failed to parse JSON for: $file_path", 2);
        return false;
    }
    
    // Find video and audio streams
    $video_stream = null;
    $audio_streams = [];
    $subtitle_streams = [];
    
    if (isset($json['streams'])) {
        foreach ($json['streams'] as $stream) {
            switch ($stream['codec_type']) {
                case 'video':
                    if ($video_stream === null) { // Take first video stream
                        $video_stream = $stream;
                    }
                    break;
                case 'audio':
                    $audio_streams[] = $stream;
                    break;
                case 'subtitle':
                    $subtitle_streams[] = $stream;
                    break;
            }
        }
    }
    
    $metadata = [];
    $metadata['analysis_time'] = 0; // Will be set at the end
    
    // ===== STANDARD LEVEL (always executed) =====
    $metadata = array_merge($metadata, extractStandardMetadata($json, $video_stream));
    
    // ===== MORE LEVEL =====
    if (in_array($config['info_level'], ['more', 'max', 'full'])) {
        $metadata = array_merge($metadata, extractMoreMetadata($json, $video_stream, $audio_streams));
    }
    
    // ===== MAX LEVEL =====
    if (in_array($config['info_level'], ['max', 'full'])) {
        $metadata = array_merge($metadata, extractMaxMetadata($file_path, $json, $video_stream, $subtitle_streams));
    }
    
    // ===== FULL LEVEL =====
    if ($config['info_level'] === 'full') {
        $metadata = array_merge($metadata, extractFullMetadata($file_path, $json, $video_stream, $audio_streams));
    }
    
    $metadata['raw_json'] = $json_string;
    $metadata['analysis_time'] = round((microtime(true) - $start_time) * 1000, 2); // in milliseconds
    
    return $metadata;
}

function extractStandardMetadata($json, $video_stream) {
    $metadata = [];
    
    // Extract duration from format
    if (isset($json['format']['duration'])) {
        $duration_seconds = floatval($json['format']['duration']);
        $metadata['duration_seconds'] = $duration_seconds;
        $metadata['duration'] = secondsToTimeString($duration_seconds);
    } else {
        $metadata['duration_seconds'] = '';
        $metadata['duration'] = '';
    }
    
    // Extract video bitrate (estimate from total bitrate)
    if (isset($json['format']['bit_rate'])) {
        $total_bitrate = intval($json['format']['bit_rate']);
        $metadata['video_bitrate'] = formatBitrate($total_bitrate * 0.8); // Assume 80% is video
    } else {
        $metadata['video_bitrate'] = '';
    }
    
    // Extract video stream properties
    if ($video_stream) {
        $metadata['codec_long_name'] = $video_stream['codec_long_name'] ?? '';
        $metadata['codec_name'] = $video_stream['codec_name'] ?? '';
        $metadata['width'] = $video_stream['width'] ?? '';
        $metadata['height'] = $video_stream['height'] ?? '';
        $metadata['display_aspect_ratio'] = $video_stream['display_aspect_ratio'] ?? '';
        $metadata['sample_aspect_ratio'] = $video_stream['sample_aspect_ratio'] ?? '';
        $metadata['color_space'] = $video_stream['color_space'] ?? '';
        $metadata['pix_fmt'] = $video_stream['pix_fmt'] ?? '';
        $metadata['r_frame_rate'] = $video_stream['r_frame_rate'] ?? '';
        $metadata['field_order'] = $video_stream['field_order'] ?? '';
        $metadata['nb_frames'] = $video_stream['nb_frames'] ?? '';
        
        // Extract timecode from tags
        if (isset($video_stream['tags']['timecode'])) {
            $metadata['timecode'] = $video_stream['tags']['timecode'];
        } else {
            $metadata['timecode'] = '';
        }
    } else {
        // No video stream found - fill with empty values
        $metadata = array_merge($metadata, [
            'codec_long_name' => '', 'codec_name' => '', 'width' => '', 'height' => '',
            'display_aspect_ratio' => '', 'sample_aspect_ratio' => '', 'color_space' => '',
            'pix_fmt' => '', 'r_frame_rate' => '', 'field_order' => '', 'nb_frames' => '',
            'timecode' => ''
        ]);
    }
    
    // Extract creation time
    if (isset($json['format']['tags']['creation_time'])) {
        $metadata['creation_time'] = $json['format']['tags']['creation_time'];
    } else {
        $metadata['creation_time'] = '';
    }
    
    return $metadata;
}

function extractMoreMetadata($json, $video_stream, $audio_streams) {
    $metadata = [];
    
    // ===== AUDIO ANALYSIS =====
    if (!empty($audio_streams)) {
        $primary_audio = $audio_streams[0]; // Use first audio stream for primary info
        
        $metadata['audio_codec'] = $primary_audio['codec_name'] ?? '';
        $metadata['audio_bitrate'] = isset($primary_audio['bit_rate']) ? formatBitrate(intval($primary_audio['bit_rate'])) : '';
        $metadata['audio_channels'] = $primary_audio['channels'] ?? '';
        $metadata['audio_sample_rate'] = isset($primary_audio['sample_rate']) ? $primary_audio['sample_rate'] . ' Hz' : '';
        $metadata['audio_language'] = $primary_audio['tags']['language'] ?? '';
        $metadata['audio_streams_count'] = count($audio_streams);
    } else {
        $metadata = array_merge($metadata, [
            'audio_codec' => '', 'audio_bitrate' => '', 'audio_channels' => '',
            'audio_sample_rate' => '', 'audio_language' => '', 'audio_streams_count' => 0
        ]);
    }
    
    // ===== EXTENDED VIDEO PROPERTIES =====
    if ($video_stream) {
        $metadata['video_profile'] = $video_stream['profile'] ?? '';
        $metadata['video_level'] = $video_stream['level'] ?? '';
        $metadata['bit_depth'] = $video_stream['bits_per_raw_sample'] ?? ($video_stream['bits_per_sample'] ?? '');
        
        // Chroma subsampling info
        if (isset($video_stream['chroma_location'])) {
            $metadata['chroma_subsampling'] = $video_stream['chroma_location'];
        } elseif (isset($video_stream['pix_fmt'])) {
            // Guess from pixel format
            $pix_fmt = $video_stream['pix_fmt'];
            if (strpos($pix_fmt, '420') !== false) $metadata['chroma_subsampling'] = '4:2:0';
            elseif (strpos($pix_fmt, '422') !== false) $metadata['chroma_subsampling'] = '4:2:2';
            elseif (strpos($pix_fmt, '444') !== false) $metadata['chroma_subsampling'] = '4:4:4';
            else $metadata['chroma_subsampling'] = '';
        } else {
            $metadata['chroma_subsampling'] = '';
        }
        
        // Encoding tool
        if (isset($video_stream['tags']['encoder'])) {
            $metadata['encoding_tool'] = $video_stream['tags']['encoder'];
        } elseif (isset($json['format']['tags']['encoder'])) {
            $metadata['encoding_tool'] = $json['format']['tags']['encoder'];
        } else {
            $metadata['encoding_tool'] = '';
        }
    } else {
        $metadata = array_merge($metadata, [
            'video_profile' => '', 'video_level' => '', 'bit_depth' => '',
            'chroma_subsampling' => '', 'encoding_tool' => ''
        ]);
    }
    
    // ===== CONTAINER FORMAT =====
    $metadata['container_format'] = $json['format']['format_long_name'] ?? '';
    
    return $metadata;
}

function extractMaxMetadata($file_path, $json, $video_stream, $subtitle_streams) {
    global $config;
    $metadata = [];
    
    // ===== ADVANCED VIDEO ANALYSIS =====
    if ($video_stream) {
        // GOP and B-frame analysis
        if (isset($video_stream['has_b_frames'])) {
            $metadata['b_frames'] = $video_stream['has_b_frames'];
        } else {
            $metadata['b_frames'] = '';
        }
        
        // GOP size estimation (if available)
        $metadata['gop_size'] = ''; // Would need additional analysis
        
        // More accurate bitrate calculation
        if (isset($video_stream['bit_rate'])) {
            $video_bitrate = intval($video_stream['bit_rate']);
        } elseif (isset($json['format']['bit_rate']) && isset($json['format']['duration'])) {
            // Estimate video bitrate as 80% of total
            $video_bitrate = intval($json['format']['bit_rate']) * 0.8;
        } else {
            $video_bitrate = 0;
        }
        
        if ($video_bitrate > 0) {
            // Calculate compression ratio
            $width = intval($video_stream['width'] ?? 0);
            $height = intval($video_stream['height'] ?? 0);
            $fps = calculateFrameRate($video_stream['r_frame_rate'] ?? '');
            
            if ($width > 0 && $height > 0 && $fps > 0) {
                $uncompressed_bitrate = $width * $height * 24 * $fps; // 24-bit RGB
                $compression_ratio = round($uncompressed_bitrate / $video_bitrate, 2);
                $metadata['compression_ratio'] = $compression_ratio . ':1';
                
                // Quality score estimation (higher is better)
                $pixels_per_second = $width * $height * $fps;
                $bits_per_pixel = $video_bitrate / $pixels_per_second;
                $quality_score = min(100, max(10, $bits_per_pixel * 20));
                $metadata['quality_score'] = round($quality_score, 1);
            } else {
                $metadata['compression_ratio'] = '';
                $metadata['quality_score'] = '';
            }
        } else {
            $metadata['compression_ratio'] = '';
            $metadata['quality_score'] = '';
        }
        
        // Interlace detection (more detailed)
        $field_order = $video_stream['field_order'] ?? '';
        if ($field_order === 'progressive') {
            $metadata['interlace_detection'] = 'Progressive';
        } elseif (in_array($field_order, ['tt', 'bb', 'tb', 'bt'])) {
            $metadata['interlace_detection'] = 'Interlaced (' . $field_order . ')';
        } else {
            $metadata['interlace_detection'] = 'Unknown';
        }
        
        // Motion level estimation (based on B-frames)
        $has_b_frames = intval($video_stream['has_b_frames'] ?? 0);
        if ($has_b_frames > 2) {
            $metadata['motion_level'] = 'High';
        } elseif ($has_b_frames > 0) {
            $metadata['motion_level'] = 'Medium';
        } else {
            $metadata['motion_level'] = 'Low';
        }
    } else {
        $metadata = array_merge($metadata, [
            'gop_size' => '', 'b_frames' => '', 'compression_ratio' => '',
            'quality_score' => '', 'interlace_detection' => '', 'motion_level' => ''
        ]);
    }
    
    // ===== TOTAL BITRATE =====
    if (isset($json['format']['bit_rate'])) {
        $metadata['total_bitrate'] = formatBitrate(intval($json['format']['bit_rate']));
    } else {
        $metadata['total_bitrate'] = '';
    }
    
    // ===== SUBTITLE AND CHAPTER INFO =====
    $metadata['subtitle_tracks'] = count($subtitle_streams);
    
    // Chapter count (if available)
    if (isset($json['chapters'])) {
        $metadata['chapter_count'] = count($json['chapters']);
    } else {
        $metadata['chapter_count'] = 0;
    }
    
    // ===== FILE SYSTEM PROPERTIES =====
    if (file_exists($file_path)) {
        $stat = stat($file_path);
        $metadata['file_permissions'] = substr(sprintf('%o', fileperms($file_path)), -4);
        $metadata['last_modified'] = date('Y-m-d H:i:s', $stat['mtime']);
    } else {
        $metadata['file_permissions'] = '';
        $metadata['last_modified'] = '';
    }
    
    return $metadata;
}

function extractFullMetadata($file_path, $json, $video_stream, $audio_streams) {
    global $config;
    $metadata = [];
    
    // ===== ALL STREAMS ANALYSIS =====
    $all_streams = $json['streams'] ?? [];
    $metadata['all_streams_count'] = count($all_streams);
    
    $video_streams_count = 0;
    foreach ($all_streams as $stream) {
        if ($stream['codec_type'] === 'video') {
            $video_streams_count++;
        }
    }
    $metadata['video_streams_count'] = $video_streams_count;
    
    // ===== ADVANCED DIAGNOSTICS =====
    // Format compliance check
    $format_name = $json['format']['format_name'] ?? '';
    if (strpos($format_name, 'mp4') !== false) {
        $metadata['compliance_status'] = 'MP4 Standard';
    } elseif (strpos($format_name, 'matroska') !== false) {
        $metadata['compliance_status'] = 'Matroska Standard';
    } else {
        $metadata['compliance_status'] = 'Other Format';
    }
    
    // Encoding complexity estimation
    if ($video_stream) {
        $profile = strtolower($video_stream['profile'] ?? '');
        if (strpos($profile, 'high') !== false) {
            $complexity = 'High';
        } elseif (strpos($profile, 'main') !== false) {
            $complexity = 'Medium';
        } else {
            $complexity = 'Low';
        }
        $metadata['encoding_complexity'] = $complexity;
    } else {
        $metadata['encoding_complexity'] = '';
    }
    
    // ===== CONTENT ANALYSIS (Performance-intensive) =====
    // This would require additional FFmpeg analysis commands
    // For now, we'll use placeholders with estimated values
    
    $metadata['black_frames_start'] = ''; // Would need: ffmpeg -i file -vf blackdetect
    $metadata['black_frames_end'] = '';
    $metadata['scene_changes'] = ''; // Would need: ffmpeg -i file -vf select='gt(scene,0.3)'
    $metadata['duplicate_frames'] = ''; // Would need: ffmpeg -i file -vf mpdecimate
    
    // ===== FORMAT TAGS =====
    $format_tags = [];
    if (isset($json['format']['tags'])) {
        foreach ($json['format']['tags'] as $key => $value) {
            if (!in_array($key, ['creation_time', 'encoder'])) {
                $format_tags[] = "$key=$value";
            }
        }
    }
    $metadata['format_tags'] = implode('; ', $format_tags);
    
    // ===== MUXING TOOL =====
    if (isset($json['format']['tags']['ENCODER'])) {
        $metadata['muxing_tool'] = $json['format']['tags']['ENCODER'];
    } elseif (isset($json['format']['tags']['encoder'])) {
        $metadata['muxing_tool'] = $json['format']['tags']['encoder'];
    } elseif (isset($json['format']['tags']['muxingapp'])) {
        $metadata['muxing_tool'] = $json['format']['tags']['muxingapp'];
    } else {
        $metadata['muxing_tool'] = '';
    }
    
    $metadata['raw_analysis_time'] = ''; // Will be set by caller
    
    return $metadata;
}

function calculateFrameRate($frame_rate_string) {
    if (empty($frame_rate_string)) return 0;
    
    if (strpos($frame_rate_string, '/') !== false) {
        $parts = explode('/', $frame_rate_string);
        if (count($parts) === 2 && $parts[1] != 0) {
            return floatval($parts[0]) / floatval($parts[1]);
        }
    }
    
    return floatval($frame_rate_string);
}

