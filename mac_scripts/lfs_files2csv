        'color_space' => $metadata['color_space'] ?? '',
        'pixel_format' => $metadata['pix_fmt'] ?? '',
        'frame_rate' => $metadata['r_frame_rate'] ?? '',
        'scan_type' => $metadata['field_order'] ?? '',
        'frames' => $metadata['nb_frames'] ?? '',
        'timecode' => $metadata['timecode'] ?? '',
        'creation_time' => $metadata['creation_time'] ?? '',
