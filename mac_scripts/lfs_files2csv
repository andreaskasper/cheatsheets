function initializeOutputFile() {
    global $config, $output_file, $entries_written;

    // Bei der Wiederaufnahme steht schon etwas in der Datei.
    if ($entries_written > 0 && file_exists($output_file)) {
        return;
    }

    switch ($config['output_format']) {
        case 'csv':
            $labels = [];
            foreach (getColumns() as $column) {
                $labels[] = csvField($column[0]);
            }
            // BOM, damit Excel und Numbers die Umlaute in der Kopfzeile richtig
            // anzeigen.
            file_put_contents($output_file, "\xEF\xBB\xBF" . implode(';', $labels) . "\n");
            break;

        case 'json':
            file_put_contents($output_file, "[\n");
            break;

        case 'xml':
            file_put_contents($output_file, '<?xml version="1.0" encoding="UTF-8"?>' . "\n<video_files>\n");
            break;
    }
}

function writeToOutputFile($record) {
    global $config;

    switch ($config['output_format']) {
        case 'csv':
            return writeCSVLine($record);
        case 'json':
            return writeJSONEntry($record);
        case 'xml':
            return writeXMLEntry($record);
    }

    return false;
}

function csvField($value) {
    $value = (string)$value;
    // Ein Zeilenumbruch innerhalb einer Zelle ist erlaubt, macht die Datei aber
    // fuer viele Werkzeuge unbrauchbar. Deshalb ersetzen.
    $value = str_replace(["\r\n", "\r", "\n"], ' ', $value);

    // CSV maskiert Anfuehrungszeichen durch Verdoppeln, nicht durch
    // Backslashes. Bis 3.0.2 stand hier addslashes, was jede Datei mit einem
    // Anfuehrungszeichen im Pfad und jede Zeile mit +raw zerlegt hat.
    return '"' . str_replace('"', '""', $value) . '"';
}

function writeCSVLine($record) {
    global $output_file;

    $parts = [];
    foreach (getColumns() as $column) {
        list($label, $key, $type) = $column;
        $value = $record[$key] ?? '';

        if ($type === 'int' && $value !== '' && is_numeric($value)) {
            $parts[] = (string)intval($value);
        } else {
            $parts[] = csvField($value);
        }
    }

    return file_put_contents($output_file, implode(';', $parts) . "\n", FILE_APPEND) !== false;
}

function writeJSONEntry($record) {
    global $output_file, $entries_written;

    $data = [];
    foreach (getColumns() as $column) {
        list($label, $key, $type) = $column;
        $value = $record[$key] ?? '';

        if ($type === 'int') {
            $data[$key] = ($value === '') ? 0 : intval($value);
        } elseif ($type === 'float') {
            $data[$key] = ($value === '') ? 0.0 : floatval($value);
        } else {
            $data[$key] = (string)$value;
        }
    }

    $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if ($entries_written > 0) {
        $json = ",\n" . $json;
    }

    $ok = file_put_contents($output_file, $json, FILE_APPEND) !== false;
    if ($ok) {
        $entries_written++;
    }

    return $ok;
}

function writeXMLEntry($record) {
    global $output_file, $entries_written;

    $xml = "  <video>\n";
    foreach (getColumns() as $column) {
        list($label, $key, $type) = $column;
        $value = (string)($record[$key] ?? '');
        // Steuerzeichen sind in XML 1.0 nicht erlaubt und machen die Datei
        // unlesbar, egal wie sie maskiert werden.
        $value = preg_replace('/[\x00-\x08\x0B\x0C\x0E-\x1F]/u', '', $value);
        $xml .= '    <' . $key . '>'
            . htmlspecialchars((string)$value, ENT_XML1 | ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8')
            . '</' . $key . ">\n";
    }
    $xml .= "  </video>\n";

    $ok = file_put_contents($output_file, $xml, FILE_APPEND) !== false;
    if ($ok) {
        $entries_written++;
    }

    return $ok;
}

function finalizeOutputFile() {
    global $config, $output_file;

    switch ($config['output_format']) {
        case 'json':
            file_put_contents($output_file, "\n]\n", FILE_APPEND);
            break;
        case 'xml':
            file_put_contents($output_file, "</video_files>\n", FILE_APPEND);
            break;
    }
}

// ================ ANZEIGE ================
function updateProgress($current, $total, $filename) {
    global $config, $stats, $processing_start;

    if ($config['verbose_level'] === 0 || $total <= 0) {
        return;
    }

    $percent    = round(($current / $total) * 100, 1);
    $bar_length = 30;

    // Der Laptop markiert die aktuelle Stelle. Er belegt eine der 30 Stellen,
    // deshalb bar_length - 1 - $filled Striche dahinter: die Breite bleibt
    // dadurch ueber den ganzen Lauf gleich und die Zeile springt nicht.
    $filled = intval($bar_length * ($current / $total));
    $filled = max(0, min($bar_length - 1, $filled));
    $bar    = str_repeat('=', $filled) . PROGRESS_MARKER
        . str_repeat('-', $bar_length - 1 - $filled);

    // Restzeit aus dem bisherigen Tempo. Grundlage sind nur die wirklich
    // verarbeiteten Dateien: bei +resume gehen die uebersprungenen ohne
    // nennenswerte Zeit durch und wuerden die Schaetzung zu optimistisch machen.
    $eta  = null;
    $done = $stats['files_processed'];
    if ($done > 0 && $processing_start > 0.0) {
        $elapsed = microtime(true) - $processing_start;
        if ($elapsed > 0) {
            $eta = ($total - $current) * ($elapsed / $done);
        }
    }

    printf("\r[%s] %5.1f%% ETA %s (%d/%d) %-40s", $bar, $percent, formatEta($eta),
        $current, $total, mb_substr($filename, 0, 40));
}

function formatEta($seconds) {
    if ($seconds === null || !is_finite((float)$seconds) || $seconds < 0) {
        return '--:--:--';
    }

    $seconds = (int)round($seconds);
    if ($seconds > 359999) {
        // Gedeckelt, damit die Zeile immer gleich breit bleibt.
        return '99:59:59';
    }

    return sprintf('%02d:%02d:%02d',
        intdiv($seconds, 3600), intdiv($seconds % 3600, 60), $seconds % 60);
}

function showStatistics() {
    global $stats, $config, $output_file, $report_file;

    $duration      = max(0, time() - $stats['start_time']);
    $nicht_erfasst = $stats['non_video'] + $stats['hidden_files'];
    $ordner_aus    = $stats['hidden_dirs'] + $stats['excluded_dirs'] + $stats['symlink_dirs'];

    output("", 1);
    output("=== Zusammenfassung ===", 1);
    output("Detailgrad: " . $config['info_level'], 1);
    output("Dateien insgesamt: " . number_format($stats['total_files_found'], 0, ',', '.'), 1);
    output("Videodateien: " . number_format($stats['video_files_found'], 0, ',', '.'), 1);
    output("Verarbeitet: " . number_format($stats['files_processed'], 0, ',', '.'), 1);
    output("Uebersprungen: " . number_format($stats['files_skipped'], 0, ',', '.'), 1);
    output("Fehler: " . number_format($stats['errors'], 0, ',', '.'), 1);

    // Die Differenz zwischen "Dateien insgesamt" und "Videodateien" aufgeloest.
    output("Nicht erfasst: " . number_format($nicht_erfasst, 0, ',', '.')
        . " (" . number_format($stats['non_video'], 0, ',', '.') . " ohne Videoendung, "
        . number_format($stats['hidden_files'], 0, ',', '.') . " versteckt)", 1);

    if ($ordner_aus > 0) {
        output("Ausgelassene Ordner: " . number_format($ordner_aus, 0, ',', '.')
            . " (" . $stats['hidden_dirs'] . " versteckt, "
            . $stats['excluded_dirs'] . " per +exclude, "
            . $stats['symlink_dirs'] . " Symlink)", 1);
    }

    output("Datenmenge: " . formatBytes($stats['total_size']), 1);
    output("Laufzeit: " . formatDuration($duration), 1);

    if ($stats['files_processed'] > 0 && $duration > 0) {
        $avg = $duration / $stats['files_processed'];
        output("Tempo: " . number_format($stats['files_processed'] / $duration, 2, ',', '.')
            . " Dateien/Sekunde", 1);
        output("Durchschnitt je Datei: " . number_format($avg, 2, ',', '.') . " Sekunden", 1);
    }

    output("Spitzenspeicher: " . formatBytes(memory_get_peak_usage(true)), 1);

    if (!$config['dry_run']) {
        output("Ausgabedatei: " . $output_file, 1);
    }

    if ($report_file !== '') {
        output("Bericht: " . $report_file, 1);
    } elseif ($nicht_erfasst > 0 || $stats['errors'] > 0 || $ordner_aus > 0) {
        output("Welche Dateien das genau sind, listet ein Lauf mit +report auf.", 1);
    }

    output("Fertig: " . date('Y-m-d H:i:s'), 1);
}

function cleanup() {
    global $progress_file, $progress_handle, $config, $stats;

    if ($progress_handle !== null) {
        fclose($progress_handle);
        $progress_handle = null;
    }

    // Die Fortschrittsdatei bleibt liegen, wenn Fehler aufgetreten sind. Dann
    // kann der Lauf mit +resume gezielt wiederholt werden.
    if (!$config['dry_run'] && $stats['errors'] === 0 && file_exists($progress_file)) {
        @unlink($progress_file);
    } elseif (!$config['dry_run'] && $stats['errors'] > 0) {
        output("Fortschrittsdatei bleibt erhalten, Wiederaufnahme mit +resume moeglich.", 1);
    }
}

// ================ HILFSFUNKTIONEN ================
function output($message, $min_verbose_level = 1) {
    global $config;

    if ($config['verbose_level'] >= $min_verbose_level) {
        echo $message . "\n";
    }
}

function error($message, $fatal = false) {
    fprintf(STDERR, "\n\033[31m[FEHLER]\033[0m %s\n", $message);
    if ($fatal) {
        exit(1);
    }
}

function formatBytes($bytes, $precision = 2) {
    $units = ['Byte', 'KB', 'MB', 'GB', 'TB', 'PB'];
    $bytes = max((float)$bytes, 0);
    $pow   = ($bytes > 0) ? floor(log($bytes) / log(1024)) : 0;
    $pow   = (int)min($pow, count($units) - 1);
    $bytes /= pow(1024, $pow);

    return number_format($bytes, $precision, ',', '.') . ' ' . $units[$pow];
}

function formatBitrate($bitrate) {
    $bitrate = (float)$bitrate;

    if ($bitrate >= 1000000) {
        return number_format($bitrate / 1000000, 2, ',', '.') . ' Mbps';
    }
    if ($bitrate >= 1000) {
        return number_format($bitrate / 1000, 2, ',', '.') . ' kbps';
    }

    return round($bitrate) . ' bps';
}

function secondsToTimeString($seconds) {
    $seconds = max(0.0, (float)$seconds);

    $hours   = (int)floor($seconds / 3600);
    $minutes = (int)floor(fmod($seconds, 3600) / 60);
    // fmod statt %, sonst waren die Millisekunden bis 3.0.2 immer 000.
    $secs    = fmod($seconds, 60);

    return sprintf('%02d:%02d:%06.3f', $hours, $minutes, $secs);
}

function formatDuration($seconds) {
    $seconds = (int)$seconds;

    if ($seconds < 60) {
        return $seconds . 's';
    }
    if ($seconds < 3600) {
        return intdiv($seconds, 60) . 'm ' . ($seconds % 60) . 's';
    }

    return intdiv($seconds, 3600) . 'h ' . intdiv($seconds % 3600, 60) . 'm ' . ($seconds % 60) . 's';
}
