#!/usr/bin/env php
<?php
/**
 * LFS Files to CSV - Video-Metadaten fuer die Bestandserfassung
 *
 * Durchsucht einen Ordner rekursiv nach Videodateien und liest die Metadaten
 * mit ffprobe aus. Ergebnis als CSV, JSON oder XML, mit Wiederaufnahme nach
 * Abbruch.
 *
 * Ein Skript fuer Manuel vom Haus des Dokumentarfilms
 * Autor: Andreas Kasper <andreas.kasper@goo1.de>
 * Version: siehe VERSION
 *
 * Aufruf:
 *   lfs_files2csv <ordner> [optionen]
 *
 * Optionen: siehe --help
 */

// Der Speicherbedarf waechst seit 3.1.0 nicht mehr mit der Dateizahl: der
// Verzeichnisbaum wird streamend verarbeitet und die Fortschrittsliste
// zeilenweise angehaengt statt jedes Mal komplett neu serialisiert. Das Limit
// hier ist nur noch der Sicherheitsgurt fuer einzelne sehr grosse
// ffprobe-Ausgaben (Material mit hunderten Streams oder Kapiteln).
ini_set('memory_limit', '-1');

// ================ KONFIGURATION ================
const VERSION = '3.2.0';

const SUPPORTED_EXTENSIONS = [
    // bis 3.0.2 bekannt
    '.mp4', '.mov', '.avi', '.mpg', '.mpeg', '.mkv', '.wmv', '.flv', '.webm',
    '.m4v', '.3gp', '.asf',
    // ab 3.1.0: in Fernseh- und Kameraarchiven ueblich
    '.mxf', '.mts', '.m2ts', '.dv', '.vob', '.ts', '.m2v', '.ogv', '.rm',
];

const FFPROBE_PATHS = ['/opt/homebrew/bin/ffprobe', '/usr/local/bin/ffprobe', '/usr/bin/ffprobe', 'ffprobe'];
const FFMPEG_PATHS  = ['/opt/homebrew/bin/ffmpeg', '/usr/local/bin/ffmpeg', '/usr/bin/ffmpeg', 'ffmpeg'];

const PROGRESS_FILE_PREFIX = '.lfs_progress_';
const PROGRESS_FILE_SUFFIX = '.jsonl';

const UPDATER_NAME = 'update-andiscripts.sh';

// Markierung der aktuellen Stelle im Fortschrittsbalken.
const PROGRESS_MARKER = "\u{1F4BB}";

// ================ GLOBALE VARIABLEN ================
$config = [
    'directory'        => '',
    'directory_real'   => '',
    'checksum_enabled' => false,
    'output_format'    => 'csv',
    'dry_run'          => false,
    'verbose_level'    => 1, // 0=quiet, 1=normal, 2=verbose
    'resume'           => false,
    'raw_data'         => false,
    'report'           => false,
    'exclude_patterns' => [],
    'ffprobe_path'     => '',
    'ffmpeg_path'      => '',
    'info_level'       => 'standard', // standard/more/max/full
];

$stats = [
    'total_files_found' => 0,
    'video_files_found' => 0,
    'files_processed'   => 0,
    'files_skipped'     => 0,
    'errors'            => 0,
    'start_time'        => 0,
    'total_size'        => 0,
    // Was nicht in der Tabelle landet, aufgeschluesselt nach Grund. Mit +report
    // steht jeder einzelne Pfad dazu in der Berichtsdatei.
    'non_video'         => 0, // keine bekannte Videoendung
    'hidden_files'      => 0, // versteckte Dateien
    'hidden_dirs'       => 0, // versteckte Ordner
    'excluded_dirs'     => 0, // per +exclude ausgelassen
    'symlink_dirs'      => 0, // verknuepfte Ordner
];

$processed_files  = [];   // Pfad => true, nur bei +resume gefuellt
$entries_written  = 0;    // bereits in die Ausgabedatei geschriebene Datensaetze
$output_file      = '';
$progress_file    = '';
$progress_handle  = null;
$counting_pass    = false;
$resumed          = false; // true nur, wenn ein alter Lauf wirklich fortgesetzt wird
$processing_start = 0.0;   // Beginn der Verarbeitung, Grundlage der ETA
$report_file      = '';
$report_handle    = null;

// ================ ABLAUF ================
main();

function main() {
    global $config, $stats, $output_file;

    $stats['start_time'] = time();

    if (!parseArguments()) {
        exit(1);
    }

    if (!findFFmpegTools()) {
        error("ffprobe nicht gefunden. Bitte ffmpeg installieren (brew install ffmpeg).", true);
    }

    setupFiles();

    output("=== LFS Files to CSV v" . VERSION . " ===", 1);
    output("Ordner: " . $config['directory'], 1);
    output("Ausgabeformat: " . strtoupper($config['output_format']), 1);
    output("Detailgrad: " . $config['info_level'], 1);
    output("Ausgabedatei: " . $output_file, 1);

    if ($config['dry_run']) {
        output("TROCKENLAUF - es wird nichts geschrieben", 1);
    }
    if ($config['raw_data']) {
        output("Rohdaten-Spalte aktiv (+raw)", 1);
    }
    if ($config['report']) {
        output("Bericht wird mitgeschrieben (+report)", 1);
    }
    if (!empty($config['exclude_patterns'])) {
        output("Ausgeschlossen: " . implode(', ', $config['exclude_patterns']), 1);
    }
    output("", 1);

    // Erster Durchlauf: nur zaehlen. Speichert keine Pfade, wird aber fuer die
    // Prozentanzeige gebraucht.
    output("Zaehle Dateien ...", 1);
    list($total_files, $video_files) = countFiles($config['directory']);
    $stats['total_files_found'] = $total_files;
    $stats['video_files_found'] = $video_files;

    output("Gefunden: " . number_format($total_files, 0, ',', '.') . " Dateien insgesamt", 1);
    output("Davon Video: " . number_format($video_files, 0, ',', '.'), 1);
    output("", 1);

    if ($video_files === 0) {
        output("Keine Videodateien gefunden.", 1);
        exit(0);
    }

    if (!$config['dry_run']) {
        initializeOutputFile();
        openProgressLog();
    }

    // Auch im Trockenlauf: der Bericht ist der Zweck der Kombination +dry +report.
    openReport();

    // Zweiter Durchlauf: verarbeiten, streamend.
    processVideoFiles($video_files);

    if (!$config['dry_run']) {
        finalizeOutputFile();
    }

    finalizeReport();
    showStatistics();
    cleanup();

    // Rueckgabewert 1, wenn mindestens eine Datei nicht gelesen werden konnte.
    // Damit laesst sich ein Lauf in einem groesseren Ablauf bewerten, ohne die
    // Bildschirmausgabe zu durchsuchen.
    exit($stats['errors'] > 0 ? 1 : 0);
}

// ================ ARGUMENTE ================
function parseArguments() {
    global $argv, $config;

    if (count($argv) < 2) {
        showUsage();
        return false;
    }

    for ($i = 1; $i < count($argv); $i++) {
        $arg = $argv[$i];
        if (in_array($arg, ['--help', '-h', 'help', '?'], true)) {
            showUsage();
            exit(0);
        }
        if (in_array($arg, ['--version', '-v', 'version'], true)) {
            showVersion();
            exit(0);
        }
        if (in_array($arg, ['update', 'upgrade'], true)) {
            runUpdater();
            return false;
        }
    }

    // Ein einzelner Schraegstrich darf nicht zu einem leeren Pfad werden.
    $dir = $argv[1];
    if ($dir !== '/') {
        $dir = rtrim($dir, '/');
    }
    if ($dir === '') {
        $dir = '.';
    }
    $config['directory'] = $dir;

    if (!is_dir($config['directory'])) {
        error("Ordner '" . $config['directory'] . "' existiert nicht oder ist nicht lesbar.", true);
        return false;
    }

    $real = realpath($config['directory']);
    $config['directory_real'] = ($real === false) ? $config['directory'] : $real;

    for ($i = 2; $i < count($argv); $i++) {
        $arg = $argv[$i];

        switch ($arg) {
            case '+md5':
                $config['checksum_enabled'] = true;
                break;
            case '+json':
                $config['output_format'] = 'json';
                break;
            case '+xml':
                $config['output_format'] = 'xml';
                break;
            case '+dry':
                $config['dry_run'] = true;
                break;
            case '+quiet':
                $config['verbose_level'] = 0;
                break;
            case '+verbose':
                $config['verbose_level'] = 2;
                break;
            case '+resume':
                $config['resume'] = true;
                break;
            case '+raw':
                $config['raw_data'] = true;
                break;
            case '+report':
                $config['report'] = true;
                break;
            default:
                if (strpos($arg, '+exclude=') === 0) {
                    $pattern = substr($arg, 9);
                    if ($pattern !== '') {
                        $config['exclude_patterns'][] = $pattern;
                    }
                } elseif (strpos($arg, '+info=') === 0) {
                    $level = substr($arg, 6);
                    if (in_array($level, ['standard', 'more', 'max', 'full'], true)) {
                        $config['info_level'] = $level;
                    } else {
                        error("Unbekannter Detailgrad: $level (moeglich: standard/more/max/full)", true);
                    }
                } else {
                    error("Unbekannte Option: $arg", true);
                }
        }
    }

    return true;
}

