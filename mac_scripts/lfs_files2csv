#!/usr/bin/env php
<?php
/**
 * LFS Files to CSV - Enhanced Video Metadata Extractor
 * 
 * Recursively scans directories for video files and extracts metadata using FFmpeg/FFprobe.
 * Exports data to CSV, JSON, or XML formats with resume capability and progress tracking.
 * 
 * Author: Andreas Kasper (enhanced by Claude)
 * Version: 3.0.2
 * 
 * Usage:
 *   ./lfs_files2csv <directory> [options]
 * 
 * Options:
 *   +md5           - Calculate MD5/SHA1 checksums (slower)
 *   +json          - Output as JSON instead of CSV
 *   +xml           - Output as XML instead of CSV
 *   +dry           - Dry run mode (show what would be processed)
 *   +quiet         - Minimal output
 *   +verbose       - Detailed output
 *   +resume        - Resume from previous interrupted run
 *   +exclude=pattern - Exclude paths containing pattern (can be used multiple times)
 * 
 * Examples:
 *   ./lfs_files2csv /path/to/videos
 *   ./lfs_files2csv /path/to/videos +md5 +json +verbose
 *   ./lfs_files2csv /path/to/videos +exclude=temp +exclude=backup +dry
 */

// ================ CONFIGURATION ================
const SUPPORTED_EXTENSIONS = ['.mp4', '.mov', '.avi', '.mpg', '.mpeg', '.mkv', '.wmv', '.flv', '.webm', '.m4v', '.3gp', '.asf'];
const FFPROBE_PATHS = ['/usr/local/bin/ffprobe', '/usr/bin/ffprobe', 'ffprobe'];
const FFMPEG_PATHS = ['/usr/local/bin/ffmpeg', '/usr/bin/ffmpeg', 'ffmpeg'];
const PROGRESS_FILE_SUFFIX = '.lfs_progress';
const MAX_PARALLEL_JOBS = 3; // For future parallel processing

// ================ GLOBAL VARIABLES ================
$config = [
    'directory' => '',
    'checksum_enabled' => false,
    'output_format' => 'csv',
    'dry_run' => false,
    'verbose_level' => 1, // 0=quiet, 1=normal, 2=verbose
    'resume' => false,
    'exclude_patterns' => [],
    'ffprobe_path' => '',
    'ffmpeg_path' => '',
    'info_level' => 'standard', // standard/more/max/full
];

$stats = [
    'total_files_found' => 0,
    'video_files_found' => 0,
    'files_processed' => 0,
    'files_skipped' => 0,
    'errors' => 0,
    'start_time' => 0,
    'total_size' => 0,
];

$processed_files = [];
$output_file = '';
$progress_file = '';

// ================ MAIN EXECUTION ================
main();

function main() {
    global $config, $stats, $output_file, $progress_file;
    
    $stats['start_time'] = time();
    
    // Parse command line arguments
    if (!parseArguments()) {
        exit(1);
    }
    
    // Find FFmpeg/FFprobe executables
    if (!findFFmpegTools()) {
        error("FFmpeg/FFprobe not found. Please install FFmpeg.", true);
    }
    
    // Setup output and progress files
    setupFiles();
    
    // Load progress if resuming
    if ($config['resume']) {
        loadProgress();
    }
    
    output("=== LFS Files to CSV v3.0.2 ===", 1);
    output("Directory: " . $config['directory'], 1);
    output("Output format: " . strtoupper($config['output_format']), 1);
    output("Info level: " . $config['info_level'], 1);
    output("Output file: " . basename($output_file), 1);
    
    if ($config['dry_run']) {
        output("DRY RUN MODE - No files will be processed", 1);
    }
    
    if (!empty($config['exclude_patterns'])) {
        output("Exclude patterns: " . implode(', ', $config['exclude_patterns']), 1);
    }
    
    output("", 1);
    
    // Scan directory for files
    $all_files = scanDirectoryRecursive($config['directory']);
    $video_files = filterVideoFiles($all_files);
    
    $stats['total_files_found'] = count($all_files);
    $stats['video_files_found'] = count($video_files);
    
    output("Found " . $stats['total_files_found'] . " total files", 1);
    output("Found " . $stats['video_files_found'] . " video files", 1);
    output("", 1);
    
    if ($stats['video_files_found'] == 0) {
        output("No video files found.", 1);
        exit(0);
    }
    
    // Initialize output file
    if (!$config['dry_run']) {
        initializeOutputFile();
    }
    
    // Process files
    processVideoFiles($video_files);
    
    // Finalize output
    if (!$config['dry_run']) {
        finalizeOutputFile();
    }
    
    // Show statistics
    showStatistics();
    
    // Cleanup
    cleanup();
}

function parseArguments() {
    global $argv, $config;
    
    if (count($argv) < 2) {
        showUsage();
        return false;
    }
    
    // Check for help and version flags first
    for ($i = 1; $i < count($argv); $i++) {
        $arg = $argv[$i];
        if (in_array($arg, ['--help', '-h', 'help', '?'])) {
            showUsage();
            return false;
        }
        if (in_array($arg, ['--version', '-v', 'version'])) {
            showVersion();
            return false;
        }
    }
    
    $config['directory'] = rtrim($argv[1], '/');
    
    if (!is_dir($config['directory'])) {
        error("Directory '" . $config['directory'] . "' does not exist or is not accessible.", true);
        return false;
    }
    
    // Parse options
    for ($i = 2; $i < count($argv); $i++) {
        $arg = $argv[$i];
        
        switch ($arg) {
            case '+md5':
                $config['checksum_enabled'] = true;
                break;
            case '+json':
                $config['output_format'] = 'json';
                break;
            case '+xml':
                $config['output_format'] = 'xml';
                break;
            case '+dry':
                $config['dry_run'] = true;
                break;
            case '+quiet':
                $config['verbose_level'] = 0;
                break;
            case '+verbose':
                $config['verbose_level'] = 2;
                break;
            case '+resume':
                $config['resume'] = true;
                break;
            default:
                if (strpos($arg, '+exclude=') === 0) {
                    $pattern = substr($arg, 9);
                    if (!empty($pattern)) {
                        $config['exclude_patterns'][] = $pattern;
                    }
                } elseif (strpos($arg, '+info=') === 0) {
                    $level = substr($arg, 6);
                    if (in_array($level, ['standard', 'more', 'max', 'full'])) {
                        $config['info_level'] = $level;
                    } else {
                        error("Invalid info level: $level (use: standard/more/max/full)", false);
                    }
                } else {
                    error("Unknown option: $arg", false);
                }
        }
    }
    
    return true;
}

