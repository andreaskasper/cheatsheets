    $metadata = getVideoMetadata($file_path);
    if ($metadata === false) {
        error("Failed to extract metadata from: $file_path", false);
        return false;
    }
    
    // Calculate checksums if enabled
    $md5 = '';
    $sha1 = '';
    if ($config['checksum_enabled']) {
