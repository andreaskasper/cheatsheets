function updateProgress($current, $total, $filename) {
    global $config;
    
    if ($config['verbose_level'] == 0) return; // Quiet mode
    
    $percent = round(($current / $total) * 100, 1);
    $bar_length = 30;
    $filled_length = intval($bar_length * ($current / $total));
    $bar = str_repeat('=', $filled_length) . str_repeat('-', $bar_length - $filled_length);
    
    $progress_text = sprintf("\r[%s] %s%% (%d/%d) %s", 
        $bar, 
        $percent, 
        $current, 
        $total, 
        mb_substr($filename, 0, 40)
    );
    
    echo $progress_text;
}

function showStatistics() {
    global $stats, $config;
    
    $duration = time() - $stats['start_time'];
    
    output("\n=== Processing Statistics ===", 1);
    output("Info level: " . $config['info_level'] . " (performance-based analysis)", 1);
    output("Total files found: " . number_format($stats['total_files_found']), 1);
    output("Video files found: " . number_format($stats['video_files_found']), 1);
    output("Files processed: " . number_format($stats['files_processed']), 1);
    output("Files skipped: " . number_format($stats['files_skipped']), 1);
    output("Errors encountered: " . number_format($stats['errors']), 1);
    output("Total data size: " . formatBytes($stats['total_size']), 1);
    output("Processing time: " . formatDuration($duration), 1);
    
    if ($stats['files_processed'] > 0 && $duration > 0) {
        $rate = $stats['files_processed'] / $duration;
        $avg_time_per_file = $duration / $stats['files_processed'];
        output("Processing rate: " . number_format($rate, 2) . " files/second", 1);
        output("Average time per file: " . number_format($avg_time_per_file, 2) . " seconds", 1);
        
        // Show performance expectations based on info level
        $expected_times = [
            'standard' => 0.1,
            'more' => 0.2,
            'max' => 0.5,
            'full' => 1.5
        ];
        
        $expected = $expected_times[$config['info_level']] ?? 0.1;
        $performance_ratio = $avg_time_per_file / $expected;
        
        if ($performance_ratio > 1.5) {
            $performance_status = "slower than expected";
        } elseif ($performance_ratio < 0.5) {
            $performance_status = "faster than expected";  
        } else {
            $performance_status = "as expected";
        }
        
        output("Performance: " . number_format($performance_ratio, 2) . "x " . $performance_status . 
               " (expected ~" . $expected . "s per file for " . $config['info_level'] . " level)", 1);
    }
    
    // Show data throughput
    if ($stats['total_size'] > 0 && $duration > 0) {
        $throughput = $stats['total_size'] / $duration;
        output("Data throughput: " . formatBytes($throughput) . "/second", 1);
    }
    
    output("Finished at: " . date("Y-m-d H:i:s"), 1);
}

function cleanup() {
    global $progress_file, $config;
    
    // Remove progress file if processing completed successfully
    if (!$config['dry_run'] && file_exists($progress_file)) {
        unlink($progress_file);
    }
}

// ================ UTILITY FUNCTIONS ================

function output($message, $min_verbose_level = 1) {
    global $config;
    
    if ($config['verbose_level'] >= $min_verbose_level) {
        echo $message . "\n";
    }
}

function error($message, $fatal = false) {
    fprintf(STDERR, "\033[31m[ERROR]\033[0m %s\n", $message);
    if ($fatal) {
        exit(1);
    }
}

function formatBytes($bytes, $precision = 2) {
    $units = ['Byte', 'KB', 'MB', 'GB', 'TB', 'PB'];
    $bytes = max($bytes, 0);
    $pow = floor(($bytes ? log($bytes) : 0) / log(1024));
    $pow = min($pow, count($units) - 1);
    $bytes /= (1 << (10 * $pow));
    return number_format($bytes, $precision, ',', '.') . $units[$pow];
}

function formatBitrate($bitrate) {
    if ($bitrate >= 1000000) {
        return number_format($bitrate / 1000000, 2) . ' Mbps';
    } elseif ($bitrate >= 1000) {
        return number_format($bitrate / 1000, 2) . ' kbps';
    } else {
        return $bitrate . ' bps';
    }
}

function secondsToTimeString($seconds) {
    $hours = floor($seconds / 3600);
    $minutes = floor(($seconds % 3600) / 60);
    $secs = $seconds % 60;
    
    return sprintf('%02d:%02d:%06.3f', $hours, $minutes, $secs);
}

function formatDuration($seconds) {
    if ($seconds < 60) {
        return $seconds . 's';
    } elseif ($seconds < 3600) {
        return floor($seconds / 60) . 'm ' . ($seconds % 60) . 's';
    } else {
        $hours = floor($seconds / 3600);
        $minutes = floor(($seconds % 3600) / 60);
        $secs = $seconds % 60;
        return $hours . 'h ' . $minutes . 'm ' . $secs . 's';
    }
}

