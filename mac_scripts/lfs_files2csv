function runUpdater() {
    $candidates = [
        dirname(realpath($GLOBALS['argv'][0]) ?: $GLOBALS['argv'][0]) . '/' . UPDATER_NAME,
        '/usr/local/bin/' . UPDATER_NAME,
        '/opt/homebrew/bin/' . UPDATER_NAME,
    ];

    $found = '';
    foreach ($candidates as $candidate) {
        if (is_file($candidate) && is_executable($candidate)) {
            $found = $candidate;
            break;
        }
    }

    if ($found === '') {
        $out = []; $rc = 1;
        exec('command -v ' . escapeshellarg(UPDATER_NAME) . ' 2>/dev/null', $out, $rc);
        if ($rc === 0 && !empty($out[0])) {
            $found = $out[0];
        }
    }

    if ($found === '') {
        error(UPDATER_NAME . " nicht gefunden. Bitte einmalig manuell installieren.", true);
    }

    passthru(escapeshellarg($found), $code);
    exit($code);
}

// ================ FFPROBE ================
function findFFmpegTools() {
    global $config;

    foreach (FFPROBE_PATHS as $path) {
        if (isExecutableAvailable($path)) {
            $config['ffprobe_path'] = $path;
            break;
        }
    }

    // ffmpeg wird derzeit nicht aufgerufen, nur mitgeteilt. Ein fehlendes
    // ffmpeg darf den Lauf deshalb nicht verhindern.
    foreach (FFMPEG_PATHS as $path) {
        if (isExecutableAvailable($path)) {
            $config['ffmpeg_path'] = $path;
            break;
        }
    }

    return $config['ffprobe_path'] !== '';
}

function isExecutableAvailable($path) {
    $out = [];
    $rc  = 1;
    exec('command -v ' . escapeshellarg($path) . ' 2>/dev/null', $out, $rc);
    if ($rc === 0) {
        return true;
    }

    $out = [];
    $rc  = 1;
    exec(escapeshellarg($path) . ' -version 2>/dev/null', $out, $rc);
    return $rc === 0;
}

// ================ DATEIEN UND FORTSCHRITT ================
function setupFiles() {
    global $config, $output_file, $progress_file, $processed_files, $entries_written, $resumed;

    $parent = dirname($config['directory_real']);
    $progress_file = $parent . '/' . PROGRESS_FILE_PREFIX
        . substr(md5($config['directory_real']), 0, 12) . PROGRESS_FILE_SUFFIX;

    if ($config['resume'] && is_file($progress_file)) {
        $header = readProgressHeader($progress_file);
        if ($header === null) {
            output("Fortschrittsdatei unlesbar, der Lauf beginnt von vorn.", 1);
        } elseif (!progressMatchesConfig($header)) {
            output("Fortschrittsdatei gehoert zu anderen Einstellungen, der Lauf beginnt von vorn.", 1);
            output("  gespeichert: " . describeProgressHeader($header), 2);
        } else {
            $output_file = $header['output_file'];
            $processed_files = readProgressEntries($progress_file);
            $entries_written = count($processed_files);
            $resumed = true;
            output("Wiederaufnahme: " . number_format($entries_written, 0, ',', '.')
                . " Dateien bereits erledigt.", 1);
            output("Es wird weitergeschrieben in: " . $output_file, 1);
            return;
        }
    } elseif ($config['resume']) {
        output("Keine Fortschrittsdatei gefunden, der Lauf beginnt von vorn.", 1);
    }

    $timestamp   = date('Ymd') . 'T' . date('His');
    $output_file = $parent . '/archiv_' . $timestamp . '.' . $config['output_format'];

    if (file_exists($output_file) && !$config['dry_run']) {
        $answer = promptYesNo("Ausgabedatei existiert bereits. Ueberschreiben?");
        if (!$answer) {
            output("Abgebrochen.", 1);
            exit(0);
        }
    }
}

function progressMatchesConfig($header) {
    global $config;

    if (!isset($header['output_file']) || !is_file($header['output_file'])) {
        return false;
    }

    $keys = [
        'output_format' => $config['output_format'],
        'info_level'    => $config['info_level'],
        'checksum'      => $config['checksum_enabled'],
        'raw_data'      => $config['raw_data'],
        'directory'     => $config['directory_real'],
    ];

    foreach ($keys as $key => $value) {
        if (!array_key_exists($key, $header) || $header[$key] !== $value) {
            return false;
        }
    }

    return true;
}

function describeProgressHeader($header) {
    return sprintf(
        'Format=%s, Detailgrad=%s, md5=%s, raw=%s',
        $header['output_format'] ?? '?',
        $header['info_level'] ?? '?',
        !empty($header['checksum']) ? 'ja' : 'nein',
        !empty($header['raw_data']) ? 'ja' : 'nein'
    );
}

function readProgressHeader($path) {
    $handle = @fopen($path, 'r');
    if ($handle === false) {
        return null;
    }
    $line = fgets($handle);
    fclose($handle);
    if ($line === false) {
        return null;
    }
    $header = json_decode(trim($line), true);
    return is_array($header) ? $header : null;
}

function readProgressEntries($path) {
    $entries = [];
    $handle  = @fopen($path, 'r');
    if ($handle === false) {
        return $entries;
    }

    fgets($handle); // Kopfzeile ueberspringen
    while (($line = fgets($handle)) !== false) {
        $line = trim($line);
        if ($line === '') {
            continue;
        }
        $decoded = json_decode($line, true);
        if (is_string($decoded)) {
            $entries[$decoded] = true;
        }
    }
    fclose($handle);

    return $entries;
}

function openProgressLog() {
    global $progress_file, $progress_handle, $config, $output_file, $resumed;

    // Nur wenn wirklich fortgesetzt wird, darf an die alte Datei angehaengt
    // werden. Sonst gehoert die Kopfzeile zu einem anderen Lauf.
    $is_new = !$resumed || !is_file($progress_file);

    $progress_handle = @fopen($progress_file, $is_new ? 'w' : 'a');
    if ($progress_handle === false) {
        error("Fortschrittsdatei nicht beschreibbar: $progress_file", false);
        error("Der Lauf geht weiter, +resume wird danach aber nicht funktionieren.", false);
        $progress_handle = null;
        return;
    }

    if ($is_new) {
        $header = [
            'version'       => VERSION,
            'directory'     => $config['directory_real'],
            'output_file'   => $output_file,
            'output_format' => $config['output_format'],
            'info_level'    => $config['info_level'],
            'checksum'      => $config['checksum_enabled'],
            'raw_data'      => $config['raw_data'],
            'started'       => date('c'),
        ];
        fwrite($progress_handle, json_encode($header) . "\n");
        fflush($progress_handle);
    }
}

function saveProgress($file_path) {
    global $progress_handle;

    if ($progress_handle === null) {
        return;
    }

    // Eine Zeile anhaengen, nichts neu serialisieren. Genau das war bis 3.0.2
    // die Ursache dafuer, dass der Speicher bei grossen Bestaenden ausging.
    fwrite($progress_handle, json_encode($file_path) . "\n");
    fflush($progress_handle);
}

// ================ BERICHT ================
/**
 * Der Bericht wird waehrend des Durchlaufs zeilenweise geschrieben, nicht am
 * Ende aus einer Liste. Sonst haette man sich genau das Speicherproblem
 * zurueckgeholt, das in 3.1.0 beseitigt wurde.
 */
function openReport() {
    global $config, $report_file, $report_handle, $output_file;

    if (!$config['report']) {
        return;
    }

    // archiv_20260827T101500.csv  ->  archiv_20260827T101500.bericht.txt
    $report_file = preg_replace('/\.[^.\/]+$/', '', $output_file) . '.bericht.txt';

    // Anhaengen, damit bei +resume der Bericht des ersten Laufs erhalten bleibt.
    $report_handle = @fopen($report_file, 'a');
    if ($report_handle === false) {
        error("Bericht nicht schreibbar: $report_file", false);
        $report_handle = null;
        return;
    }

    fwrite($report_handle, str_repeat('=', 78) . "\n");
    fwrite($report_handle, "Bericht: was nicht in der Tabelle steht\n");
    fwrite($report_handle, "Ordner:  " . $config['directory_real'] . "\n");
    fwrite($report_handle, "Tabelle: " . $output_file . "\n");
    fwrite($report_handle, "Lauf:    " . date('Y-m-d H:i:s') . ", lfs_files2csv " . VERSION . "\n");
    if ($config['dry_run']) {
        fwrite($report_handle, "Hinweis: Trockenlauf, es wurde keine Tabelle geschrieben.\n");
    }
    fwrite($report_handle, str_repeat('=', 78) . "\n\n");
    fflush($report_handle);
}

function reportLine($category, $path, $reason = '') {
    global $report_handle;

    if ($report_handle === null) {
        return;
    }

    fwrite($report_handle, sprintf("%-14s %s%s\n", $category, $path,
        $reason !== '' ? '   [' . $reason . ']' : ''));
}

function finalizeReport() {
    global $report_handle, $stats, $config;

    if ($report_handle === null) {
        return;
    }

    $nicht_erfasst = $stats['non_video'] + $stats['hidden_files'];

    fwrite($report_handle, "\n" . str_repeat('-', 78) . "\n");
    fwrite($report_handle, "Zusammenfassung dieses Laufs\n\n");
    fwrite($report_handle, sprintf("  Dateien insgesamt:        %d\n", $stats['total_files_found']));
    fwrite($report_handle, sprintf("  Videodateien:             %d\n", $stats['video_files_found']));
    fwrite($report_handle, sprintf("  Verarbeitet:              %d\n", $stats['files_processed']));
    fwrite($report_handle, sprintf("  Uebersprungen:            %d\n", $stats['files_skipped']));
    fwrite($report_handle, sprintf("  Fehler:                   %d\n", $stats['errors']));
    fwrite($report_handle, sprintf("  Nicht erfasst:            %d\n", $nicht_erfasst));
    fwrite($report_handle, sprintf("    keine Videoendung:      %d\n", $stats['non_video']));
    fwrite($report_handle, sprintf("    versteckte Dateien:     %d\n", $stats['hidden_files']));
    fwrite($report_handle, sprintf("  Ausgelassene Ordner:      %d\n",
        $stats['hidden_dirs'] + $stats['excluded_dirs'] + $stats['symlink_dirs']));
    fwrite($report_handle, sprintf("    versteckt:              %d\n", $stats['hidden_dirs']));
    fwrite($report_handle, sprintf("    per +exclude:           %d\n", $stats['excluded_dirs']));
    fwrite($report_handle, sprintf("    Symlink:                %d\n", $stats['symlink_dirs']));
    fwrite($report_handle, "\nEnde des Laufs: " . date('Y-m-d H:i:s') . "\n\n");

    fclose($report_handle);
    $report_handle = null;
}

function promptYesNo($question) {
    if (!function_exists('readline')) {
        echo $question . " (j/N): ";
        $line = fgets(STDIN);
        $answer = ($line === false) ? '' : trim($line);
    } else {
        $answer = trim((string)readline($question . " (j/N): "));
    }

    return in_array(strtolower($answer), ['j', 'ja', 'y', 'yes'], true);
}

// ================ VERZEICHNIS DURCHLAUFEN ================
/**
 * Liefert die Dateipfade einzeln. Im Speicher liegen nur die noch nicht
 * besuchten Unterordner, nicht die Dateiliste.
 */
function iterateFiles($dir) {
    global $config, $stats, $counting_pass;

    $stack = [$dir];

    while (!empty($stack)) {
        $current = array_pop($stack);

        if (isExcluded($current)) {
            if (!$counting_pass) {
                output("Uebersprungen: $current", 2);
                $stats['excluded_dirs']++;
                reportLine('AUSGELASSEN', $current, 'Ordner passt auf ein +exclude-Muster');
            }
            continue;
        }

        $handle = @opendir($current);
        if ($handle === false) {
            if (!$counting_pass) {
                error("Ordner nicht lesbar: $current", false);
                $stats['errors']++;
                reportLine('FEHLER', $current, 'Ordner nicht lesbar');
            }
            continue;
        }

        $subdirs = [];
        while (($item = readdir($handle)) !== false) {
            if ($item === '.' || $item === '..') {
                continue;
            }

            $full = $current . '/' . $item;

            if (is_link($full) && is_dir($full)) {
                // Verknuepfte Ordner nicht verfolgen, sonst laeuft der Scan
                // bei einer Schleife endlos.
                if (!$counting_pass) {
                    output("Symlink auf Ordner uebersprungen: $full", 2);
                    $stats['symlink_dirs']++;
                    reportLine('AUSGELASSEN', $full, 'Verknuepfung auf einen Ordner');
                }
                continue;
            }

            if (is_dir($full)) {
                // Versteckte Ordner auslassen, genau wie md5er und md5check es
                // tun. Auf Mac-Volumes liegen dort .Trashes, .Spotlight-V100
                // und .fseventsd, deren Inhalt nicht zum Bestand gehoert.
                if (isHiddenName($item)) {
                    if (!$counting_pass) {
                        output("Versteckter Ordner uebersprungen: $full", 2);
                        $stats['hidden_dirs']++;
                        reportLine('AUSGELASSEN', $full, 'versteckter Ordner');
                    }
                    continue;
                }
                $subdirs[] = $full;
            } else {
                yield $full;
            }
        }
        closedir($handle);

        foreach ($subdirs as $subdir) {
            $stack[] = $subdir;
        }
    }
}

function isExcluded($path) {
    global $config;

    foreach ($config['exclude_patterns'] as $pattern) {
        if (strpos($path, $pattern) !== false) {
            return true;
        }
    }

    return false;
}

/**
 * Versteckte Dateien und Ordner gehoeren nicht zum Bestand. Dazu zaehlen auch
 * die AppleDouble-Reste (._name.mov) auf exFAT- und Netzlaufwerken: sie heissen
 * wie das Original, enthalten aber kein Bild.
 */
function isHiddenName($name) {
    return strpos($name, '.') === 0;
}

function hasVideoExtension($name) {
    $dot = strrpos($name, '.');
    if ($dot === false || $dot === 0) {
        return false;
    }

    return in_array(strtolower(substr($name, $dot)), SUPPORTED_EXTENSIONS, true);
}

function isVideoFile($path) {
    $name = basename($path);

    return !isHiddenName($name) && hasVideoExtension($name);
}

function countFiles($dir) {
    global $counting_pass;

    $counting_pass = true;
    $total = 0;
    $video = 0;

    foreach (iterateFiles($dir) as $path) {
        $total++;
        if (isVideoFile($path)) {
            $video++;
        }
    }

    $counting_pass = false;

    return [$total, $video];
}

// ================ VERARBEITUNG ================
function processVideoFiles($total) {
    global $stats, $processed_files, $config, $processing_start;

    $current = 0;
    // Eigene Startzeit: der Zaehldurchlauf davor gehoert nicht zur Schaetzung.
    $processing_start = microtime(true);

    foreach (iterateFiles($config['directory']) as $file_path) {
        $name = basename($file_path);

        // Alles, was hier aussortiert wird, taucht in der Tabelle nicht auf.
        // Genau danach fragt man sich hinterher, deshalb Zaehler und Bericht.
        if (isHiddenName($name)) {
            $stats['hidden_files']++;
            reportLine('AUSGELASSEN', $file_path, 'versteckte Datei');
            continue;
        }

        if (!hasVideoExtension($name)) {
            $stats['non_video']++;
            reportLine('NICHT-VIDEO', $file_path, 'keine bekannte Videoendung');
            continue;
        }

        $current++;

        if (isset($processed_files[$file_path])) {
            $stats['files_skipped']++;
            reportLine('UEBERSPRUNGEN', $file_path, 'in einem frueheren Lauf erledigt');
            updateProgress($current, $total, $name . ' (uebersprungen)');
            continue;
        }

        updateProgress($current, $total, basename($file_path));

        $size = @filesize($file_path);
        if ($size === false) {
            $size = 0;
        }

        if ($config['dry_run']) {
            output("\nWuerde verarbeiten: $file_path", 2);
            $stats['files_processed']++;
        } else {
            if (processVideoFile($file_path, $size)) {
                $stats['files_processed']++;
                saveProgress($file_path);
            } else {
                $stats['errors']++;
                reportLine('FEHLER', $file_path, 'ffprobe konnte die Datei nicht lesen');
            }
        }

        $stats['total_size'] += $size;
    }

    if ($config['verbose_level'] > 0) {
        echo "\n";
    }
}

function processVideoFile($file_path, $file_size) {
    global $config;

    $metadata = getVideoMetadata($file_path);
    if ($metadata === false) {
        error("Metadaten nicht lesbar: $file_path", false);
        return false;
    }

    $md5  = '';
    $sha1 = '';
    if ($config['checksum_enabled']) {
        $md5  = (string)md5_file($file_path);
        $sha1 = (string)sha1_file($file_path);
    }

    $record = [
        'path'             => dirname($file_path),
        'filename'         => basename($file_path),
        'file_size'        => $file_size,
        'file_size_human'  => formatBytes($file_size, 1),
        'md5'              => $md5,
        'sha1'             => $sha1,
    ] + $metadata;

    return writeToOutputFile($record);
}

function getVideoMetadata($file_path) {
    global $config;

    $start_time = microtime(true);

    $cmd = escapeshellarg($config['ffprobe_path'])
        . ' -v quiet -print_format json -show_format -show_streams -show_chapters '
        . escapeshellarg($file_path) . ' 2>/dev/null';

    $output = [];
    $return_code = 1;
    exec($cmd, $output, $return_code);

    if ($return_code !== 0) {
        output("\nffprobe fehlgeschlagen: $file_path", 2);
        return false;
    }

    $json_string = implode('', $output);
    unset($output);

    $json = json_decode($json_string, true);
    if (!is_array($json)) {
        output("\nffprobe-Ausgabe nicht lesbar: $file_path", 2);
        return false;
    }

    $video_stream     = null;
    $audio_streams    = [];
    $subtitle_streams = [];

    if (isset($json['streams']) && is_array($json['streams'])) {
        foreach ($json['streams'] as $stream) {
            switch ($stream['codec_type'] ?? '') {
                case 'video':
                    if ($video_stream === null) {
                        $video_stream = $stream;
                    }
                    break;
                case 'audio':
                    $audio_streams[] = $stream;
                    break;
                case 'subtitle':
                    $subtitle_streams[] = $stream;
                    break;
            }
        }
    }

    $metadata = extractStandardMetadata($json, $video_stream);

    if (in_array($config['info_level'], ['more', 'max', 'full'], true)) {
        $metadata = array_merge($metadata, extractMoreMetadata($json, $video_stream, $audio_streams));
    }
    if (in_array($config['info_level'], ['max', 'full'], true)) {
        $metadata = array_merge($metadata, extractMaxMetadata($file_path, $json, $video_stream, $subtitle_streams));
    }
    if ($config['info_level'] === 'full') {
        $metadata = array_merge($metadata, extractFullMetadata($json, $video_stream));
    }

    $metadata['analysis_time'] = round((microtime(true) - $start_time) * 1000, 2);
    $metadata['raw_json'] = $config['raw_data'] ? $json_string : '';

    return $metadata;
}

function extractStandardMetadata($json, $video_stream) {
    $metadata = [];

    if (isset($json['format']['duration'])) {
        $duration_seconds = floatval($json['format']['duration']);
        $metadata['duration_seconds'] = $duration_seconds;
        $metadata['duration'] = secondsToTimeString($duration_seconds);
    } else {
        $metadata['duration_seconds'] = '';
        $metadata['duration'] = '';
    }

    if (isset($video_stream['bit_rate'])) {
        $metadata['video_bitrate'] = formatBitrate(intval($video_stream['bit_rate']));
    } elseif (isset($json['format']['bit_rate'])) {
        // Schaetzung: der Ton belegt ueblicherweise rund ein Fuenftel.
        $metadata['video_bitrate'] = formatBitrate(intval($json['format']['bit_rate']) * 0.8);
    } else {
        $metadata['video_bitrate'] = '';
    }

    if ($video_stream) {
        $metadata['codec_long_name']     = $video_stream['codec_long_name'] ?? '';
        $metadata['codec_name']          = $video_stream['codec_name'] ?? '';
        $metadata['width']               = $video_stream['width'] ?? '';
        $metadata['height']              = $video_stream['height'] ?? '';
        $metadata['aspect_ratio']        = $video_stream['display_aspect_ratio'] ?? '';
        $metadata['pixel_aspect_ratio']  = $video_stream['sample_aspect_ratio'] ?? '';
        $metadata['color_space']         = $video_stream['color_space'] ?? '';
        $metadata['pixel_format']        = $video_stream['pix_fmt'] ?? '';
        $metadata['frame_rate']          = $video_stream['r_frame_rate'] ?? '';
        $metadata['scan_type']           = $video_stream['field_order'] ?? '';
        $metadata['frames']              = $video_stream['nb_frames'] ?? '';
        $metadata['timecode']            = $video_stream['tags']['timecode'] ?? '';
    } else {
        $metadata = array_merge($metadata, [
            'codec_long_name' => '', 'codec_name' => '', 'width' => '', 'height' => '',
            'aspect_ratio' => '', 'pixel_aspect_ratio' => '', 'color_space' => '',
            'pixel_format' => '', 'frame_rate' => '', 'scan_type' => '', 'frames' => '',
            'timecode' => '',
        ]);
    }

    if ($metadata['timecode'] === '' && isset($json['format']['tags']['timecode'])) {
        $metadata['timecode'] = $json['format']['tags']['timecode'];
    }

    $metadata['creation_time'] = $json['format']['tags']['creation_time'] ?? '';

    return $metadata;
}

function extractMoreMetadata($json, $video_stream, $audio_streams) {
    $metadata = [];

    if (!empty($audio_streams)) {
        $primary = $audio_streams[0];
        $metadata['audio_codec']         = $primary['codec_name'] ?? '';
        $metadata['audio_bitrate']       = isset($primary['bit_rate']) ? formatBitrate(intval($primary['bit_rate'])) : '';
        $metadata['audio_channels']      = $primary['channels'] ?? '';
        $metadata['audio_sample_rate']   = isset($primary['sample_rate']) ? $primary['sample_rate'] . ' Hz' : '';
        $metadata['audio_language']      = $primary['tags']['language'] ?? '';
        $metadata['audio_streams_count'] = count($audio_streams);
    } else {
        $metadata = array_merge($metadata, [
            'audio_codec' => '', 'audio_bitrate' => '', 'audio_channels' => '',
            'audio_sample_rate' => '', 'audio_language' => '', 'audio_streams_count' => 0,
        ]);
    }

    if ($video_stream) {
        $metadata['video_profile'] = $video_stream['profile'] ?? '';
        $metadata['video_level']   = $video_stream['level'] ?? '';
        $metadata['bit_depth']     = $video_stream['bits_per_raw_sample'] ?? ($video_stream['bits_per_sample'] ?? '');

        if (isset($video_stream['chroma_location'])) {
            $metadata['chroma_subsampling'] = $video_stream['chroma_location'];
        } elseif (isset($video_stream['pix_fmt'])) {
            $pix_fmt = $video_stream['pix_fmt'];
            if (strpos($pix_fmt, '420') !== false) {
                $metadata['chroma_subsampling'] = '4:2:0';
            } elseif (strpos($pix_fmt, '422') !== false) {
                $metadata['chroma_subsampling'] = '4:2:2';
            } elseif (strpos($pix_fmt, '444') !== false) {
                $metadata['chroma_subsampling'] = '4:4:4';
            } else {
                $metadata['chroma_subsampling'] = '';
            }
        } else {
            $metadata['chroma_subsampling'] = '';
        }

        $metadata['encoding_tool'] = $video_stream['tags']['encoder']
            ?? ($json['format']['tags']['encoder'] ?? '');
    } else {
        $metadata = array_merge($metadata, [
            'video_profile' => '', 'video_level' => '', 'bit_depth' => '',
            'chroma_subsampling' => '', 'encoding_tool' => '',
        ]);
    }

    $metadata['container_format'] = $json['format']['format_long_name'] ?? '';

    return $metadata;
}

function extractMaxMetadata($file_path, $json, $video_stream, $subtitle_streams) {
    $metadata = [];

    if ($video_stream) {
        $metadata['b_frames'] = $video_stream['has_b_frames'] ?? '';
        $metadata['gop_size'] = ''; // ffprobe liefert das nicht ohne Vollanalyse

        if (isset($video_stream['bit_rate'])) {
            $video_bitrate = floatval($video_stream['bit_rate']);
        } elseif (isset($json['format']['bit_rate'])) {
            $video_bitrate = floatval($json['format']['bit_rate']) * 0.8;
        } else {
            $video_bitrate = 0.0;
        }

        $width  = intval($video_stream['width'] ?? 0);
        $height = intval($video_stream['height'] ?? 0);
        $fps    = calculateFrameRate($video_stream['r_frame_rate'] ?? '');

        if ($video_bitrate > 0 && $width > 0 && $height > 0 && $fps > 0) {
            $uncompressed = $width * $height * 24 * $fps;
            $metadata['compression_ratio'] = round($uncompressed / $video_bitrate, 2) . ':1';

            $bits_per_pixel = $video_bitrate / ($width * $height * $fps);
            $metadata['quality_score'] = round(min(100, max(10, $bits_per_pixel * 20)), 1);
        } else {
            $metadata['compression_ratio'] = '';
            $metadata['quality_score'] = '';
        }

        $field_order = $video_stream['field_order'] ?? '';
        if ($field_order === 'progressive') {
            $metadata['interlace_detection'] = 'Progressiv';
        } elseif (in_array($field_order, ['tt', 'bb', 'tb', 'bt'], true)) {
            $metadata['interlace_detection'] = 'Zeilensprung (' . $field_order . ')';
        } else {
            $metadata['interlace_detection'] = 'unbekannt';
        }

        $has_b_frames = intval($video_stream['has_b_frames'] ?? 0);
        if ($has_b_frames > 2) {
            $metadata['motion_level'] = 'hoch';
        } elseif ($has_b_frames > 0) {
            $metadata['motion_level'] = 'mittel';
        } else {
            $metadata['motion_level'] = 'gering';
        }
    } else {
        $metadata = array_merge($metadata, [
            'gop_size' => '', 'b_frames' => '', 'compression_ratio' => '',
            'quality_score' => '', 'interlace_detection' => '', 'motion_level' => '',
        ]);
    }

    $metadata['total_bitrate'] = isset($json['format']['bit_rate'])
        ? formatBitrate(intval($json['format']['bit_rate']))
        : '';

    $metadata['subtitle_tracks'] = count($subtitle_streams);
    $metadata['chapter_count']   = isset($json['chapters']) ? count($json['chapters']) : 0;

    if (file_exists($file_path)) {
        $metadata['file_permissions'] = substr(sprintf('%o', fileperms($file_path)), -4);
        $metadata['last_modified']    = date('Y-m-d H:i:s', filemtime($file_path));
    } else {
        $metadata['file_permissions'] = '';
        $metadata['last_modified']    = '';
    }

    return $metadata;
}

function extractFullMetadata($json, $video_stream) {
    $metadata = [];

    $all_streams = $json['streams'] ?? [];
    $metadata['all_streams_count'] = count($all_streams);

    $video_streams_count = 0;
    foreach ($all_streams as $stream) {
        if (($stream['codec_type'] ?? '') === 'video') {
            $video_streams_count++;
        }
    }
    $metadata['video_streams_count'] = $video_streams_count;

    $format_name = $json['format']['format_name'] ?? '';
    if (strpos($format_name, 'mp4') !== false) {
        $metadata['compliance_status'] = 'MP4';
    } elseif (strpos($format_name, 'matroska') !== false) {
        $metadata['compliance_status'] = 'Matroska';
    } elseif (strpos($format_name, 'mxf') !== false) {
        $metadata['compliance_status'] = 'MXF';
    } elseif ($format_name !== '') {
        $metadata['compliance_status'] = $format_name;
    } else {
        $metadata['compliance_status'] = '';
    }

    if ($video_stream) {
        $profile = strtolower($video_stream['profile'] ?? '');
        if (strpos($profile, 'high') !== false) {
            $metadata['encoding_complexity'] = 'hoch';
        } elseif (strpos($profile, 'main') !== false) {
            $metadata['encoding_complexity'] = 'mittel';
        } else {
            $metadata['encoding_complexity'] = 'gering';
        }
    } else {
        $metadata['encoding_complexity'] = '';
    }

    // Die folgenden vier Werte brauchen eine vollstaendige Dekodierung des
    // Materials (ffmpeg mit blackdetect, select, mpdecimate). Das dauert pro
    // Datei ein Vielfaches der Laufzeit und ist bewusst nicht umgesetzt.
    $metadata['black_frames_start'] = '';
    $metadata['black_frames_end']   = '';
    $metadata['scene_changes']      = '';
    $metadata['duplicate_frames']   = '';

    $format_tags = [];
    if (isset($json['format']['tags']) && is_array($json['format']['tags'])) {
        foreach ($json['format']['tags'] as $key => $value) {
            if (!in_array($key, ['creation_time', 'encoder'], true) && is_scalar($value)) {
                $format_tags[] = "$key=$value";
            }
        }
    }
    $metadata['format_tags'] = implode('; ', $format_tags);

    $metadata['muxing_tool'] = $json['format']['tags']['ENCODER']
        ?? ($json['format']['tags']['encoder']
        ?? ($json['format']['tags']['muxingapp'] ?? ''));

    return $metadata;
}

function calculateFrameRate($frame_rate_string) {
    if ($frame_rate_string === '' || $frame_rate_string === null) {
        return 0.0;
    }

    if (strpos($frame_rate_string, '/') !== false) {
        $parts = explode('/', $frame_rate_string);
        if (count($parts) === 2 && floatval($parts[1]) != 0.0) {
            return floatval($parts[0]) / floatval($parts[1]);
        }
        return 0.0;
    }

    return floatval($frame_rate_string);
}

