            'audio_bitrate' => $metadata['audio_bitrate'] ?? '',
            'audio_channels' => $metadata['audio_channels'] ?? '',
            'audio_sample_rate' => $metadata['audio_sample_rate'] ?? '',
            'audio_language' => $metadata['audio_language'] ?? '',
            'audio_streams_count' => $metadata['audio_streams_count'] ?? 0,
            'video_profile' => $metadata['video_profile'] ?? '',
            'video_level' => $metadata['video_level'] ?? '',
            'bit_depth' => $metadata['bit_depth'] ?? '',
            'chroma_subsampling' => $metadata['chroma_subsampling'] ?? '',
            'encoding_tool' => $metadata['encoding_tool'] ?? '',
            'container_format' => $metadata['container_format'] ?? ''
        ]);
